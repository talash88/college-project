# ML: Hugging Face cache, transient checkpoints, large weight files.
# Keep project metadata/config (label_map.json, train_config.json,
# metadata.json, metrics*.json) — retrain with scripts/train_classifier.py.
.cache/huggingface/
.huggingface/
backend/ml/artifacts/**/model.safetensors
backend/ml/artifacts/**/*.bin
backend/ml/artifacts/**/checkpoint-*/
backend/ml/artifacts/**/runs/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
# Additional CampusXolve safety rules

**/.env
**/.env.*
!**/.env.example

.ruff_cache/

backend/storage/**
!backend/storage/.gitkeep

*.dump
*.backup

*.safetensors
pytorch_model.bin

**/*.tsbuildinfo

