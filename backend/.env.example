# CampusXolve AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=CampusXolve AI
APP_DESCRIPTION=AI-Powered Campus Problem Solving
ENVIRONMENT=development
DEBUG=true

# API
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://campusxolve:campusxolve@localhost:5432/campusxolve
DATABASE_ECHO=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# CORS Origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# JWT (Step 3 authentication)
# NEVER use the placeholder below outside local development. Production refuses
# to boot unless JWT_SECRET_KEY is a non-default secret of >= 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Test database (pytest only; defaults to the campusxolve_test database on the
# same server when unset). The suite fails fast rather than touching DATABASE_URL.
# TEST_DATABASE_URL=postgresql+asyncpg://campusxolve:campusxolve@localhost:5432/campusxolve_test

# Logging
LOG_LEVEL=INFO

# Storage (local disk; mount a persistent volume in Docker)
STORAGE_DIR=storage/problem-attachments
MAX_ATTACHMENT_SIZE_MB=10
MAX_ATTACHMENTS_PER_PROBLEM=5

# AI artifacts (DistilBERT weights are gitignored; see docs/STEP_17_DEPLOYMENT.md)
CLASSIFICATION_MODEL_DIR=ml/artifacts/problem_classifier
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.60
SKILL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Priority bands / duplicate thresholds (defaults are the audited v1 values)
PRIORITY_LOW_MAX=29
PRIORITY_MEDIUM_MAX=54
PRIORITY_HIGH_MAX=79
DUPLICATE_CANDIDATE_THRESHOLD=0.60
DUPLICATE_STRONG_THRESHOLD=0.82

# Rate limiting (requests/minute; disabled when ENVIRONMENT=test)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=120